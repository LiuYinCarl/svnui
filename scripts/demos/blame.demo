# 文件查找 -> 文件历史 -> 溯源 -> 弹窗内搜索
wait 3.0
ctrl p
wait 2.5
type pattern_formatter
wait 1.2
snap finder
key enter
wait 2.0
snap file-history
type b
wait 3.5
snap blame
type /
wait 0.6
type set_pattern
wait 1.2
type n
wait 0.6
type n
wait 1.0
snap blame-search
key esc
wait 0.5
key esc
wait 0.5
key esc
wait 0.5
type q
