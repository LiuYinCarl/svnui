  "cards": [
    {
      "dot": "cyan",
      "title": "线程模型",
      "items": [
        "主线程跑 select! 事件循环，另设输入读取与 spinner 线程",
        "每个只读 svn 操作独占一个 worker 线程",
        "所有变更操作经单个 FIFO worker 串行执行，保证顺序"
      ]
    },
    {
      "dot": "emerald",
      "title": "UI 结构",
      "items": [
        "组件实现 DrawableComponent + ratatui 绘制，通过共享 Queue 反向通知 App",
        "单调递增请求 id 丢弃过期异步结果，pending 计数驱动 spinner",
        "keys.rs 集中维护按键映射表"
      ]
    },
    {
      "dot": "amber",
      "title": "SVN 交互",
      "items": [
        "不使用 libsvn 绑定，直接 shell out 到 svn CLI（>= 1.8）",
        "parser.rs 将 status / log / diff 文本输出解析为结构化模型"
      ]
    }
  ]
